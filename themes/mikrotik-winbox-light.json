{
    "$schema": "vscode://schemas/color-theme",
    "name": "MikroTik WinBox Light",
    "type": "light",
    "colors": {
        "editor.background": "#f4f4f4",
        "editor.foreground": "#1f1f1f",
        "editorCursor.foreground": "#00838f",
        "editorLineNumber.foreground": "#999999",
        "editorLineNumber.activeForeground": "#00838f",
        "editor.selectionBackground": "#b3d7ff",
        "editor.inactiveSelectionBackground": "#dcdcdc",
        "editorIndentGuide.background1": "#e0e0e0",
        "editorIndentGuide.activeBackground1": "#00838f66",
        "editorBracketMatch.background": "#00838f22",
        "editorBracketMatch.border": "#00838f",
        "editorGutter.background": "#f4f4f4",
        "activityBar.background": "#e8e8e8",
        "activityBar.foreground": "#00838f",
        "sideBar.background": "#ececec",
        "sideBar.foreground": "#333333",
        "statusBar.background": "#00838f",
        "statusBar.foreground": "#ffffff"
    },
    "tokenColors": [
        {
            "name": "RouterOS Comments",
            "scope": [
                "comment",
                "comment.line",
                "comment.line.number-sign.routeros"
            ],
            "settings": {
                "foreground": "#616161",
                "fontStyle": "italic"
            }
        },
        {
            "name": "RouterOS Section Command Paths",
            "scope": [
                "entity.name.section.routeros",
                "punctuation.separator.path.routeros"
            ],
            "settings": {
                "foreground": "#00838f",
                "fontStyle": "bold"
            }
        },
        {
            "name": "RouterOS Command Verbs",
            "scope": [
                "keyword.operator.command.routeros"
            ],
            "settings": {
                "foreground": "#ad1457",
                "fontStyle": "bold"
            }
        },
        {
            "name": "RouterOS Script Keywords",
            "scope": [
                "keyword.control.routeros",
                "storage.type.routeros",
                "support.function.builtin.routeros"
            ],
            "settings": {
                "foreground": "#c2185b",
                "fontStyle": "bold"
            }
        },
        {
            "name": "RouterOS Parameters / Keys",
            "scope": [
                "variable.parameter.routeros"
            ],
            "settings": {
                "foreground": "#2e7d32",
                "fontStyle": "bold"
            }
        },
        {
            "name": "RouterOS Key-Value Separator (=)",
            "scope": [
                "punctuation.separator.key-value.routeros"
            ],
            "settings": {
                "foreground": "#212121"
            }
        },
        {
            "name": "RouterOS Double Quoted Strings",
            "scope": [
                "string.quoted.double.routeros",
                "string.quoted"
            ],
            "settings": {
                "foreground": "#e65100"
            }
        },
        {
            "name": "RouterOS Escape Characters",
            "scope": [
                "constant.character.escape.routeros"
            ],
            "settings": {
                "foreground": "#d32f2f"
            }
        },
        {
            "name": "RouterOS Line Continuation",
            "scope": [
                "constant.character.escape.continuation.routeros"
            ],
            "settings": {
                "foreground": "#d32f2f",
                "fontStyle": "bold"
            }
        },
        {
            "name": "RouterOS IP & MAC Addresses",
            "scope": [
                "constant.numeric.ip.routeros",
                "constant.numeric.ipv6.routeros",
                "constant.numeric.mac.routeros"
            ],
            "settings": {
                "foreground": "#0d47a1"
            }
        },
        {
            "name": "RouterOS Numbers & Durations",
            "scope": [
                "constant.numeric.routeros",
                "constant.numeric"
            ],
            "settings": {
                "foreground": "#1565c0"
            }
        },
        {
            "name": "RouterOS Booleans & Special Values",
            "scope": [
                "constant.language.boolean.routeros",
                "constant.language.routeros"
            ],
            "settings": {
                "foreground": "#6a1b9a",
                "fontStyle": "bold"
            }
        },
        {
            "name": "RouterOS Variables",
            "scope": [
                "variable.other.routeros",
                "variable.other.interpolated.routeros"
            ],
            "settings": {
                "foreground": "#ef6c00"
            }
        },
        {
            "name": "RouterOS Operators",
            "scope": [
                "keyword.operator.logical.routeros",
                "keyword.operator.comparison.routeros",
                "keyword.operator.arithmetic.routeros"
            ],
            "settings": {
                "foreground": "#880e4f"
            }
        },
        {
            "name": "RouterOS Brackets & Delimiters",
            "scope": [
                "punctuation.section.brackets.routeros",
                "punctuation.terminator.statement.routeros"
            ],
            "settings": {
                "foreground": "#333333"
            }
        }
    ]
}

