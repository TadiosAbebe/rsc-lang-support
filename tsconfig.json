{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2022",
        "outDir": "out",
        "lib": ["ES2022"],
        "sourceMap": true,
        "rootDir": ".",
        "strict": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "skipLibCheck": true,
        "esModuleInterop": true
    },
    "include": ["src/**/*", "client/src/**/*", "server/src/**/*", "test/**/*"],
    "exclude": ["node_modules", ".vscode-test", "dist", "out"]
}

